              "    });",
              "pm.test(\"receivedData contains the updated name that was sent\", function () {",
              "        pm.expect(rawText.includes(\"JaneU\")).to.be.true;",
              "    });",
              "pm.test(\"receivedData contains the email that was sent\", function () {",
              "        pm.expect(rawText.includes(\"jane@example.com\")).to.be.true;",
